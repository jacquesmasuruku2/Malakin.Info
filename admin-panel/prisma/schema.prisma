generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model Category {
  id            String                @id @default(cuid())
  title         String
  slug          String                @unique
  description   String?
  color         String?
  icon          String?
  defaultLocale String                @default("fr")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  articles      Article[]
  media         Media[]
  liveEvents    LiveEvent[]
  translations  CategoryTranslation[]
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([categoryId])
  @@index([locale])
}

model Author {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  bio       String?
  role      String?
  email     String?
  imageUrl  String?
  imageAlt  String?
  articles  Article[]
  media     Media[]
  blogPosts BlogPost[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id           String            @id @default(cuid())
  title        String
  slug         String            @unique
  excerpt      String
  content      Json
  categoryId   String
  authorId     String?
  publishedAt  DateTime
  mainImageUrl String?
  mainImageAlt String?
  readTime     String?
  featured     Boolean           @default(false)
  views        BigInt            @default(0)
  defaultLocale String           @default("fr")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  author       Author?           @relation(fields: [authorId], references: [id])
  category     Category          @relation(fields: [categoryId], references: [id])
  comments     Comment[]
  likes        Like[]
  translations ArticleTranslation[]

  @@index([categoryId])
  @@index([authorId])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
  @@index([views(sort: Desc)])
}

model ArticleTranslation {
  id        String   @id @default(cuid())
  articleId String
  locale    String
  title     String
  excerpt   String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([articleId])
  @@index([locale])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          String    @default("reader")
  avatarUrl     String?
  bio           String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  sessions      Session[]
  comments      Comment[]
  likes         Like[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentToComment")
  content   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([userId])
  @@index([status])
}

model Like {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([articleId, userId])
  @@index([articleId])
  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model NewsletterSubscription {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  interests      Json?
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model Media {
  id           String    @id @default(cuid())
  type         String
  title        String
  slug         String    @unique
  description  String?
  url          String
  thumbnailUrl String?
  duration     BigInt?
  categoryId   String?
  authorId     String?
  publishedAt  DateTime
  views        BigInt    @default(0)
  featured     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  author       Author?   @relation(fields: [authorId], references: [id])
  category     Category? @relation(fields: [categoryId], references: [id])

  @@index([type])
  @@index([categoryId])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
}

model Donation {
  id             String    @id @default(cuid())
  donorName      String?
  donorEmail     String?
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("EUR")
  type           String
  status         String    @default("pending")
  message        String?
  isAnonymous    Boolean   @default(false)
  paymentMethod  String?
  transactionId  String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model Partnership {
  id          String    @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  type        String
  description String?
  status      String    @default("pending")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([type])
}

model PressRelease {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  excerpt      String
  content      Json
  source       String
  type         String
  publishedAt  DateTime
  mainImageUrl String?
  mainImageAlt String?
  featured     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
}

model JobOffer {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  requirements String?
  location    String?
  type        String
  salary      String?
  companyId   String?
  publishedAt DateTime
  deadline    DateTime?
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  applications JobApplication[]

  @@index([type])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
  @@index([deadline])
}

model JobApplication {
  id         String   @id @default(cuid())
  jobOfferId String
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  coverLetter String?
  resumeUrl  String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BlogPost {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  excerpt      String
  content      Json
  type         String
  authorId     String?
  publishedAt  DateTime
  mainImageUrl String?
  mainImageAlt String?
  readTime     String?
  featured     Boolean  @default(false)
  views        BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       Author?  @relation(fields: [authorId], references: [id])

  @@index([type])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
}

model LiveEvent {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  description  String?
  thumbnail    String?
  streamUrl    String?
  youtubeUrl   String?
  status       LiveStatus @default(SCHEDULED)
  startTime    DateTime
  endTime      DateTime?
  viewerCount  Int        @default(0)
  isFeatured   Boolean    @default(false)
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([startTime])
  @@index([isFeatured])
  @@index([categoryId])
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
}

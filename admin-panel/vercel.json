{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/translation-jobs/worker",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "src/app/api/translation-jobs/worker/route.ts": {
      "maxDuration": 180
    },
    "src/app/api/newsletter/send/route.ts": {
      "maxDuration": 300
    }
  }
}

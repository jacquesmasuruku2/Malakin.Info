generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model Category {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String?
  color         String?
  icon          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  defaultLocale String   @default("fr")
  articles      Article[]
  media         Media[]
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  locale      String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, locale])
  @@index([categoryId])
  @@index([locale])
}

model Author {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  bio       String?
  role      String?
  email     String?
  imageUrl  String?
  imageAlt  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  articles  Article[]
  blogPosts BlogPost[]
  media     Media[]
}

model Article {
  id                String             @id @default(cuid())
  title             String
  slug              String             @unique
  excerpt           String
  content           Json
  categoryId        String
  authorId          String?
  publishedAt       DateTime
  mainImageUrl      String?
  externalLink      String?
  mainImageAlt      String?
  additionalImages  Json?              @default("[]")
  additionalImageDescriptions Json?    @default("[]")
  readTime          String?
  featured          Boolean            @default(false)
  isPremium         Boolean            @default(false)
  premiumPrice      Decimal?           @db.Decimal(10, 2)
  views             BigInt             @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  defaultLocale     String             @default("fr")
  author            Author?            @relation(fields: [authorId], references: [id])
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  comments          Comment[]
  likes             Like[]
  favorites         UserFavorite[]
  sponsoredArticles SponsoredArticle[]
  articlePurchases  ArticlePurchase[]

  @@index([categoryId])
  @@index([authorId])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
  @@index([isPremium])
  @@index([views(sort: Desc)])
}

model SponsoredArticle {
  id            String   @id @default(cuid())
  articleId     String?
  title         String
  imageUrl      String
  targetUrl     String
  sponsorName   String
  categoryBadge String   @default("Publicité")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  article       Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([isActive])
  @@index([sortOrder])
}

model ArticleTranslation {
  id        String   @id @default(cuid())
  articleId String
  locale    String
  title     String
  excerpt   String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, locale])
  @@index([articleId])
  @@index([locale])
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  passwordHash  String
  role          String          @default("reader")
  avatarUrl     String?
  bio           String?
  isActive      Boolean         @default(true)
  emailVerified Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lastLoginAt   DateTime?
  comments      Comment[]
  likes         Like[]
  favorites     UserFavorite[]
  donations     Donation[]
  preferences   UserPreference?
  sessions      Session[]
  articlePurchases ArticlePurchase[]
  subscriptions Subscription[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  parentId  String?
  content   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentToComment")

  @@index([articleId])
  @@index([userId])
  @@index([status])
}

model Like {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId])
  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model NewsletterSubscription {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  interests      Json?
  name           String?
}

model Media {
  id           String    @id @default(cuid())
  type         String
  title        String
  slug         String    @unique
  description  String?
  url          String
  thumbnailUrl String?
  duration     BigInt?
  categoryId   String?
  authorId     String?
  publishedAt  DateTime
  views        BigInt    @default(0)
  featured     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  author       Author?   @relation(fields: [authorId], references: [id])
  category     Category? @relation(fields: [categoryId], references: [id])

  @@index([type])
  @@index([categoryId])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
}

model Donation {
  id            String   @id @default(cuid())
  userId        String?
  donorName     String?
  donorEmail    String?
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("EUR")
  type          String
  status        String   @default("pending")
  message       String?
  isAnonymous   Boolean  @default(false)
  paymentMethod String?
  stripeSessionId String? @unique
  transactionId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([userId])
}

model UserFavorite {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
}

model ArticlePurchase {
  id          String   @id @default(cuid())
  userId      String
  articleId   String
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  status      String   @default("completed")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([articleId])
  @@index([expiresAt])
  @@index([status])
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  status      String   @default("active")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([status])
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  locale           String   @default("fr")
  theme            String   @default("light")
  emailNewsletter  Boolean  @default(false)
  emailDigest      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Partnership {
  id          String    @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  type        String
  description String?
  imageUrl    String?
  websiteUrl  String?
  status      String    @default("pending")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([type])
}

model PressRelease {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  excerpt      String
  content      Json
  source       String
  type         String
  publishedAt  DateTime
  mainImageUrl String?
  mainImageAlt String?
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
}

model JobOffer {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String
  requirements String?
  details     Json? @default("{}")
  imageUrl    String?
  location    String?
  type        String
  salary      String?
  companyId   String?
  publishedAt DateTime
  deadline    DateTime?
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  applications JobApplication[]

  @@index([type])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
  @@index([deadline])
}

model JobApplication {
  id          String   @id @default(cuid())
  jobOfferId  String
  name        String
  email       String
  phone       String?
  coverLetter String?
  resumeUrl   String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobOffer    JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  excerpt      String
  content      Json
  type         String
  authorId     String?
  publishedAt  DateTime
  mainImageUrl String?
  mainImageAlt String?
  readTime     String?
  featured     Boolean  @default(false)
  views        BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       Author?  @relation(fields: [authorId], references: [id])

  @@index([type])
  @@index([publishedAt(sort: Desc)])
  @@index([featured])
}

model LiveEvent {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String?
  thumbnail   String?
  streamUrl   String?
  youtubeUrl  String?
  streamType  StreamType   @default(VIDEO)
  status      LiveStatus   @default(SCHEDULED)
  startTime   DateTime
  endTime     DateTime?
  viewerCount Int          @default(0)
  isFeatured  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  categoryId  String?

  @@index([status])
  @@index([startTime])
  @@index([isFeatured])
  @@index([categoryId])
}

model LiveViewerSession {
  id          String   @id @default(cuid())
  liveEventId String
  sessionId   String
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}

model RadioStation {
  id          String        @id @default(cuid())
  name        String
  streamUrl   String
  logoUrl     String?
  description String?
  showLabel   Boolean  @default(true)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  programs    RadioProgram[]
}

model RadioProgram {
  id          String        @id @default(cuid())
  stationId   String?
  title       String
  slug        String        @unique
  host        String?
  description String?
  streamUrl   String?
  imageUrl    String?
  startTime   DateTime
  endTime     DateTime?
  isLive      Boolean       @default(false)
  isFeatured  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  station     RadioStation? @relation(fields: [stationId], references: [id])

  @@index([stationId])
  @@index([startTime])
  @@index([isLive])
  @@index([isFeatured])
}

enum LiveStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum StreamType {
  VIDEO
  AUDIO
}

enum crdb_internal_region {
  aws_eu_central_1 @map("aws-eu-central-1")
}
